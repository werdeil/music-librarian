# Copy to .env (ignored by git) and adapt to the host's paths.

# Folder mounted in the container; must hold both the library and the Inbox
MUSIC_LIBRARIAN_VOLUME=/srv/music
MUSIC_LIBRARIAN_ROOT=/srv/music/Library
MUSIC_LIBRARIAN_INBOX=/srv/music/Inbox

# Owner of the files written
PUID=1000
PGID=1000
# Time zone of the container (dates of the _done/ folders, times on the
# dashboard), UTC by default
TZ=Europe/Paris

# Port of the dashboard on the host (no authentication: home network only)
# WEB_PORT=8080
# Names the dashboard is reached by, comma-separated, besides an IP address,
# a name without a dot (nas) or under .local, .lan, .home, .home.arpa, .internal
# MUSIC_LIBRARIAN_WEB_HOSTS=nas.example.org

# Lyrion Music Server (optional): prefs folder holding persist.db, and the
# library root as Lyrion sees it
# LYRION_PREFS_DIR=/srv/lyrion/prefs
# LYRION_MUSIC_ROOT=/music
# Lyrion's address, to wait for the end of its scans before changing files and
# before the carry-over (login only if Lyrion asks for one)
# LYRION_URL=http://lyrion:9000
# LYRION_USER=
# LYRION_PASSWORD=
# seconds between two looks at a scan, and seconds a scan is waited for
# LYRION_SCAN_POLL=5
# LYRION_SCAN_TIMEOUT=900

# Lyrics: providers tried in order
# LYRICS_PROVIDERS=lrclib,musixmatch,netease
# MUSIXMATCH_TOKEN=
# days before a track whose lyrics were not found is looked up again (0: every pass)
# LYRICS_RETRY_DAYS=30

# Genres: album lookup on iTunes (none to turn it off) and the store asked
# GENRE_LOOKUP=itunes
# ITUNES_COUNTRY=fr

# host if the host's DNS is only reachable on 127.0.0.1 (e.g. Pi-hole)
# BUILD_NETWORK=host
