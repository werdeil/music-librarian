# Copier en .env (ignoré par git) et adapter aux chemins de l'hôte.

# Dossier monté dans le conteneur ; doit contenir la bibliothèque et l'Inbox
MUSIC_LIBRARIAN_VOLUME=/srv/music
MUSIC_LIBRARIAN_ROOT=/srv/music/Musique
MUSIC_LIBRARIAN_INBOX=/srv/music/Inbox_Musique

# Propriétaire des fichiers écrits
PUID=1000
PGID=1000
TZ=Europe/Paris

# Logitech Media Server (facultatif) : dossier prefs qui contient persist.db, et racine
# de la bibliothèque telle que LMS la voit
# LMS_PREFS_DIR=/srv/lms/prefs
# LMS_MUSIC_ROOT=/music

# Paroles : fournisseurs essayés dans l'ordre
# LYRICS_PROVIDERS=lrclib,musixmatch,netease
# MUSIXMATCH_TOKEN=

# host si le DNS de l'hôte n'est joignable que sur 127.0.0.1 (ex. Pi-hole)
# BUILD_NETWORK=host
