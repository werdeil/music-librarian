# Copy to .env (ignored by git) and adapt to the host's paths.

# Folder mounted in the container; must hold both the library and the Inbox
MUSIC_LIBRARIAN_VOLUME=/srv/music
MUSIC_LIBRARIAN_ROOT=/srv/music/Library
MUSIC_LIBRARIAN_INBOX=/srv/music/Inbox

# Owner of the files written
PUID=1000
PGID=1000
TZ=Europe/Paris

# Lyrion Music Server (optional): prefs folder holding persist.db, and the
# library root as Lyrion sees it
# LMS_PREFS_DIR=/srv/lyrion/prefs
# LMS_MUSIC_ROOT=/music

# Lyrics: providers tried in order
# LYRICS_PROVIDERS=lrclib,musixmatch,netease
# MUSIXMATCH_TOKEN=

# host if the host's DNS is only reachable on 127.0.0.1 (e.g. Pi-hole)
# BUILD_NETWORK=host
