[MAIN]
# Même base que lyrion-dashboard. Lints the scripts and the tests, from the
# repo root (CI: pylint *.py tests). The tests import the modules from the
# root, as conftest.py does.
init-hook="import sys; sys.path.insert(0, '.')"

[MESSAGES CONTROL]
# Documented through module docstrings and comments where they add
# something; systematic docstrings are not enforced.
# Broad `except Exception` is deliberate resilience: one unreadable file, an
# import or an LMS write failing must not stop the loop or a whole pass.
# dict(...) is used throughout for journal records and tag dicts, and
# one-line lambdas as tag getters in read_tags/copy_tags.
# The passes (rank, process, watch's loop) are linear pipelines read top to
# bottom sharing local state; splitting them into helpers to satisfy the
# size counters would scatter that state without making them clearer.
disable=
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    too-few-public-methods,
    broad-exception-caught,
    use-dict-literal,
    unnecessary-lambda-assignment,
    too-many-locals,
    too-many-branches,
    too-many-statements

[FORMAT]
max-line-length=110

[DESIGN]
# rank() receives the parsed arguments plus the run context (root, state,
# log, LMS, interruptible); the test fixtures build tracks from tag kwargs.
max-args=7
max-positional-arguments=7
# music-librarian dispatches each subcommand with its own return.
max-returns=8
