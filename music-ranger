#!/usr/bin/env python3
"""
music-ranger — point d'entrée unique.

  music-ranger range  [options]            rangement (music_ranger.py)
  music-ranger import [options]            import de l'Inbox (import_inbox.py)
  music-ranger undo JOURNAL [options]      annulation d'un passage
  music-ranger watch  [options]            surveillance de l'Inbox (watch.py)
  music-ranger enrich [options]            gain, pochettes, paroles manquants (enrich.py)

Tout est en dry-run sans --apply. `music-ranger <commande> --help` pour les options.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import enrich  # noqa: E402
import import_inbox  # noqa: E402
import music_ranger  # noqa: E402
import watch  # noqa: E402


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if argv else 2
    cmd, rest = argv[0], argv[1:]
    if cmd == "range":
        return music_ranger.main(rest)
    if cmd == "import":
        return import_inbox.main(rest)
    if cmd == "undo":
        if not rest or rest[0].startswith("-"):
            print("usage : music-ranger undo JOURNAL [--apply] [options]", file=sys.stderr)
            return 2
        return music_ranger.main(["--undo", rest[0], *rest[1:]])
    if cmd == "watch":
        return watch.main(rest)
    if cmd == "enrich":
        return enrich.main(rest)
    print(f"commande inconnue : {cmd}\n\n{__doc__.strip()}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    music_ranger.handle_stop_signals()
    sys.exit(main())
